---
type Props = {
  name: string;
  url: string;
  description?: string;
  badge?: string;
};

const { name, url, description, badge } = Astro.props;
---

<a class="featured-card" href={url}>
  <h3 class="featured-card__name">{name}</h3>
  <div class="featured-card__badge-container">
    {
      badge ? (
        <img
          class="featured-card__badge"
          src={badge}
          alt={""}
          width="88"
          height="31"
          loading="lazy"
          onerror="this.onerror=null; this.src='/placeholder-badge.svg';"
        />
      ) : (
        <div class="featured-card__badge-placeholder" />
      )
    }
  </div>
  {description && <p class="featured-card__description">{description}</p>}
</a>

<style>
  .featured-card {
    display: grid;
    grid-template-columns: minmax(0, 1fr) auto;
    grid-template-rows: auto auto;
    gap: 2rem;
    padding: 1rem;
    margin: 0.5rem 0;
    border-radius: 8px;
    border: 1px solid var(--border);
    background: var(--card);
    text-decoration: none;
    color: var(--text);
    transition:
      transform 200ms ease-in-out,
      opacity 200ms ease-in-out,
      box-shadow 200ms ease-in-out;
    cursor: pointer;
    box-shadow: 0 1px 2px rgba(15, 23, 42, 0.06);
  }

  .featured-card:hover {
    box-shadow: 0 4px 12px rgba(15, 23, 42, 0.15);
    border-color: var(--accent-moderator);
  }

  .featured-card:focus-visible {
    outline: 2px solid var(--ring);
    outline-offset: 2px;
  }

  .featured-card__name {
    grid-column: 1;
    grid-row: 1;
    min-width: 0;
    margin: 0;
    font-size: 1.125rem;
    font-weight: 600;
    color: var(--text);
    line-height: 1.3;
  }

  .featured-card__description {
    grid-column: 1 / -1;
    grid-row: 2;
    min-width: 0;
    margin: 0;
    font-size: 0.9375rem;
    color: var(--muted);
    line-height: 1.5;
  }

  .featured-card__badge-container {
    grid-column: 2;
    grid-row: 1;
    align-self: start;
  }

  .featured-card__badge {
    width: 88px;
    height: 31px;
    object-fit: contain;
    border-radius: 4px;
    background: var(--surface);
  }

  .featured-card__badge-placeholder {
    width: 88px;
    height: 31px;
    border-radius: 4px;
    border: 2px dashed var(--border);
    box-sizing: content-box;
  }

  .featured-card__visit-link {
    display: inline-flex;
    align-items: center;
    gap: 0.25rem;
    color: var(--accent-moderator);
    font-size: 0.875rem;
    font-weight: 500;
    text-decoration: none;
    transition: color 200ms ease-in-out;
    flex-shrink: 0;
  }

  .featured-card__visit-link:hover {
    color: var(--accent-moderator-hover);
  }

  .featured-card__arrow {
    transition: transform 200ms ease-in-out;
    display: inline-block;
  }

  /* Mobile style */
  @media (max-width: 900px) {
    .featured-card {
      gap: 1rem;
    }

    .featured-card__name {
      align-self: stretch;
      display: flex;
      flex-direction: column;
      justify-content: center;
      font-size: 1.25rem;
      line-height: normal;
    }

    .featured-card__badge-container {
      align-self: stretch;
      display: flex;
      flex-direction: column;
      justify-content: center;
    }
  }
</style>
